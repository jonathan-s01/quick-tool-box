# Settings for docker-compose.yml. ./setup.sh copies this to .env and fills it in for this computer.
# Your .env holds the details of your own network, so it is never shared (it is in .gitignore).
# You only need to edit .env to change something. Run ./setup.sh again afterwards (it keeps your changes).
# Addresses below are examples. Replace them with your own.

# Which services run on this computer, comma separated:
#   llm   the AI models
#   apps  Quick Tool Box, Open WebUI and their helpers
#   bus   Bus times (Edmonton only)
COMPOSE_PROFILES=llm,apps

# ---------------------------------------------------------------- who may connect

# Address ranges allowed to use Quick Tool Box and Bus times, comma separated.
# ./setup.sh suggests this computer, your home network and Tailscale (100.64.0.0/10 and fd7a:115c:a1e0::/48).
# Empty means all private home network ranges and Tailscale.
# Example: 127.0.0.0/8,::1/128,192.168.1.0/24,100.64.0.0/10,fd7a:115c:a1e0::/48
ALLOWED_NETWORKS=

# Names you type in the browser for Quick Tool Box, comma separated, for example your reverse proxy name
# such as tools.example.com. Tailscale names, allowed IP addresses and localhost always work.
ALLOWED_HOSTNAMES=

# Set to 1 to ask for a password before any tool can be used, not only profiles and forms.
REQUIRE_LOGIN=
# Needed for iPhone shares when REQUIRE_LOGIN is on: a long random value (see the README).
SHARE_TOKEN=

# The AI models server (llama-swap) listens on your whole network so other computers and Home Assistant
# can use it. It has no password. Set to 127.0.0.1 to keep it on this computer only.
LLM_BIND=0.0.0.0

# ---------------------------------------------------------------- AI models

# The llama.cpp server (llama-swap). On an apps-only computer, use the AI computer's address,
# for example http://192.168.1.20:8091.
LLM_SERVER_URL=http://localhost:8091
LLM_PORT=8091

# Optional: a Mac (or other computer) running Ollama, tried before the server when it is awake.
# Several addresses, for example Ethernet then Wi-Fi, are separated by commas.
# Example: http://192.168.1.30:11434,http://192.168.1.31:11434
LLM_MAC_URLS=
# The same for Open WebUI, separated by a semicolon. ./setup.sh fills this in from LLM_MAC_URLS.
OPEN_WEBUI_OLLAMA_URLS=
OPEN_WEBUI_USE_MAC=false

# Tuning for llama.cpp. ./setup.sh works these out from this computer (./setup.sh --retune redoes it).
# After changing them: ./models.sh config, then docker compose restart llama-swap.
LLM_THREADS=
LLM_THREADS_BATCH=
LLM_CTX=
LLM_TTL=900
LLM_RAM_GB=
# Biggest picture sent to the server's AI, in pixels (longest side). Smaller is faster.
LLM_IMAGE_MAX=1024
LLM_IMAGE_MAX_TEXT=1400

# Optional: a Hugging Face read token, only needed for models that ask you to accept a licence.
HF_TOKEN=

# ---------------------------------------------------------------- apps

# Secrets, made by ./setup.sh. Keep them the same from then on (changing WEBUI_SECRET_KEY logs everyone out).
WEBUI_SECRET_KEY=
SEARXNG_SECRET=

# How many Quick Tool Box jobs may run at the same time.
MAX_JOBS=

# For ./docs.sh: an Open WebUI API key (Open WebUI, Settings, Account, API keys).
OPEN_WEBUI_API_KEY=
OPEN_WEBUI_URL=http://localhost:8080

# Bus times port, if bus is in COMPOSE_PROFILES.
BUS_PORT=3220

# Time zone, for example America/Edmonton. ./setup.sh fills this in from this computer.
TZ=
